  "authoredChallenges": [
    {
      "id": "meadow-explorer-supply",
      "giverNpcId": "npc-explorer",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          { "kind": "object-present", "typeId": "apple", "near": { "npcId": "npc-explorer", "radius": 180 } }
        ]
      },
      "stages": [
        { "conditions": [ { "kind": "entity-at", "typeId": "balloon", "region": { "minX": -300, "minY": 430, "maxX": 120, "maxY": 600 } } ] }
      ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "探险者：先给我苹果，再放一个气球标记营地。", "en": "Explorer: Bring me an apple, then mark camp with a balloon." } ]
    },
    {
      "id": "meadow-fisherman-catch",
      "giverNpcId": "npc-fisherman",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          { "kind": "object-present", "typeId": "fishingrod", "near": { "npcId": "npc-fisherman", "radius": 180 } }
        ]
      },
      "stages": [
        { "conditions": [ { "kind": "object-present", "typeId": "fish", "region": { "minX": -1250, "minY": 430, "maxX": -760, "maxY": 600 } } ] }
      ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "渔夫：先给我鱼竿，再把鱼放到河岸。", "en": "Fisher: Bring a fishing rod, then place a fish by the riverbank." } ]
    },
    {
      "id": "meadow-carpenter-repair",
      "giverNpcId": "npc-carpenter",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          { "kind": "object-present", "typeId": "hammer", "near": { "npcId": "npc-carpenter", "radius": 180 } }
        ]
      },
      "stages": [
        { "conditions": [ { "kind": "object-present", "typeId": "wood", "region": { "minX": 1150, "minY": 430, "maxX": 1650, "maxY": 600 } } ] }
      ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "木匠：工具到位后，再送来木头修桥。", "en": "Carpenter: Once the tool is ready, bring wood to repair the bridge." } ]
    },
    {
      "id": "meadow-witch-ritual",
      "giverNpcId": "npc-witch",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          { "kind": "object-present", "typeId": "crystal", "near": { "npcId": "npc-witch", "radius": 180 } }
        ]
      },
      "stages": [
        {
          "conditions": [
            { "kind": "any-of", "conditions": [
              { "kind": "object-present", "typeId": "fire", "near": { "npcId": "npc-witch", "radius": 180 } },
              { "kind": "object-present", "typeId": "lightning", "near": { "npcId": "npc-witch", "radius": 180 } }
            ] }
          ]
        }
      ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "女巫：水晶只是开始，还需要火焰或闪电完成仪式。", "en": "Witch: The crystal is only the beginning; fire or lightning completes the ritual." } ]
    },
    {
      "id": "meadow-gardener-grove",
      "giverNpcId": "npc-gardener",
      "kind": "shard",
      "puzzle": { "conditions": [ { "kind": "object-present", "typeId": "flower", "near": { "npcId": "npc-gardener", "radius": 180 } } ] },
      "stages": [ { "conditions": [ { "kind": "object-present", "typeId": "water", "near": { "npcId": "npc-gardener", "radius": 180 } } ] } ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "园丁：先找一朵花，再用水浇醒这片花圃。", "en": "Gardener: Find a flower, then water the garden back to life." } ]
    },
    {
      "id": "meadow-bridgekeeper-crossing",
      "giverNpcId": "npc-bridgekeeper",
      "kind": "starite-gate",
      "puzzle": { "conditions": [ { "kind": "object-present", "typeId": "log", "near": { "npcId": "npc-bridgekeeper", "radius": 180 } } ] },
      "stages": [ { "conditions": [ { "kind": "entity-at", "typeId": "box", "region": { "minX": 1550, "minY": 430, "maxX": 2050, "maxY": 600 } } ] } ],
      "reward": { "type": "starite", "count": 1 },
      "dialog": [ { "zh": "桥卫：先搬来木头，再把箱子放到桥头作为路障。", "en": "Bridgekeeper: Bring a log, then place a box at the bridgehead as a barrier." } ]
    },
    {
      "id": "meadow-child-clear-road",
      "giverNpcId": "npc-child",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          {
            "kind": "object-destroyed",
            "typeId": "rope",
            "region": { "minX": 600, "minY": 430, "maxX": 840, "maxY": 600 }
          }
        ]
      },
      "reward": { "type": "shard", "count": 2 },
      "dialog": [ { "zh": "孩子：这条绳索挡住了路，想办法清除它吧。", "en": "Child: This rope blocks the path. Find a way to clear it." } ]
    },
    {
      "id": "meadow-edwin-good-deed",
      "giverNpcId": "npc-edwin",
      "kind": "shard",
      "puzzle": {
        "conditions": [
          {
            "kind": "any-of",
            "conditions": [
              { "kind": "object-present", "typeId": "apple", "near": { "npcId": "npc-edwin", "radius": 220 } },
              { "kind": "object-present", "typeId": "bread", "near": { "npcId": "npc-edwin", "radius": 220 } },
              { "kind": "object-present", "typeId": "meat", "near": { "npcId": "npc-edwin", "radius": 220 } }
            ]
          }
        ]
      },
      "stages": [
        {
          "conditions": [
            { "kind": "object-present", "typeId": "water", "near": { "npcId": "npc-edwin", "radius": 220 } }
          ]
        },
        {
          "conditions": [
            { "kind": "object-destroyed", "typeId": "crate", "region": { "minX": -500, "minY": 430, "maxX": -100, "maxY": 600 } }
          ]
        }
      ],
      "reward": { "type": "shard", "count": 2 },
      "dialog": [
        {
          "zh": "Edwin：想救 Lily，就先从身边的好事开始。给我带点吃的和水，再想办法清掉挡路的木箱。",
          "en": "Edwin: If you want to save Lily, start with a good deed. Bring me food and water, then find a way to clear the crate."
        },
        {
          "zh": "提示：食物和水放到 Edwin 身边；木箱可以用火、投射物或其他有效方法处理。",
          "en": "Hint: Place food and water beside Edwin. The crate can be handled with fire, a projectile, or any effective method."
        }
      ]
    }
  ],
  "challengeSlots": 8
}
